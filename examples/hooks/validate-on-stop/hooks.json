{
  "description": "Codex How To lab hook: validate the guide when a turn stops.",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/scripts/validate_repo.py\"",
            "timeout": 30,
            "statusMessage": "Validating Codex How To"
          }
        ]
      }
    ]
  }
}
